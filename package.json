{
  "name": "hbtrk",
  "version": "1.0.0",
  "description": "Calendrier annuel pour suivre ses habitudes et organiser ses tâches quotidiennes.",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "check": "node --check app.js && npm test && npm run build:css",
    "test": "node --test scripts/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hbtrk \"node --test scripts/firestore-rules.emulator.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules --project habit-8d57f",
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./dist/style.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaimBenk/HBTRKR.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NaimBenk/HBTRKR/issues"
  },
  "homepage": "https://github.com/NaimBenk/HBTRKR#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.16",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16"
  }
}
